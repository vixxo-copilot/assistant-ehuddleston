            "col_1": {
              "content": "<h4><span style=\"color: #ffffff;\">\"</span><span style=\"color: #ffffff;\">We ran a highly competitive pilot program against two competitors for several different trades. With a focus on cost management and exceptional service, we were able to show our capabilities to deliver results.\"</span></h4>\n<h4><span style=\"color: #ffffff;\">- VP, Client Relations at Vixxo</span></h4>",
              "settings": {
                "show_divider": false
              }
            },
            "col_2": {
